#!/bin/bash  
# --------------------------------------------------------------------------- #
#                                                                             #
# nwps_trans_cgn_dev.cron : Cron manages the running of the NWPS script to    #
#             ${workdir}/trans_cgn_fields_wfo.lsf                             #
#                                                                             #
# Remarks   - Set the WFOs to process in ${NWPSdir}/parm/wfo_dev.tbl          #
#                                                                             #
# Last Changed : 01-03-2026                                     January 2026  #
# --------------------------------------------------------------------------- #

# 0.a Set necessary variables
export workdir=${VALIDATIONdir}'/graphics_cgn_dev'
export comroot=/lfs/h2/emc/ptmp/ali.salimi/com/nwps/v1.5.0
echo 'Running in '${workdir}
echo 'With COMROOT='${comroot}

# 0.b Host assessment

export script='nwps_trans_cgn_dev.cron'
export runon='BACKUPSYS'

  echo '                  ************************************************'
  echo '                  *** NWPS HOOK-IN SCRIPT nwps_plot_cgn_dev.cron  ***'
  echo '                  ************************************************'
  echo ' '
  echo " Time : `date`"
  echo ' '
  echo '        Host assessment :'
  echo '        ------------------------------------------------------------'
  echo "           script to run      : $script"
  echo "           running on         : $runon"

  export host_s="`cat /etc/HOSTNAME | cut -c1-1`"
  case $host_s in
   'c' ) host='cactus' ;;
   'd' ) host='dogwood' ;;
    *  ) echo ' '	    
         echo ' *****************************'
         echo " *** HOST $host_s NOT RECOGNIZED ***"
         echo ' *****************************'
         echo ' '
         date=`date -u +"%Y%m%d t%Hz"`
         echo "nwps.cron $date : host [$host] not recognized."
         exit 1 ;;
  esac

  echo ' '
  echo "           host machine       : $host"

  #prod=`cat /etc/prod | awk '{ print $1 }'`
  sec_profile=`cat /etc/wcoss.conf | grep sec_profile | cut -d ':' -f 2`
  echo "           machine function   : $sec_profile"

  #if [ "$runon" = 'none' ]
  #then
  #  target='none'
  #else
  #  target=`cat /etc/$runon | awk '{ print $1 }'`
  #fi
  #echo "           running on         : $runon [$target]"

  if [ "$sec_profile" != "$runon" ]
  then
    echo ' '
    echo " Time : `date`"
    echo ' '
    echo ' '
    echo '                        *** End of nwps_plot_cgn_dev.cron ***'
    exit 0
  fi

# --------------------------------------------------------------------------- #
# 1.  Manage batch job

  echo " "
  echo "        -> Submitting nwps_trans_cgn_dev.lsf at: `date`"
  qsub ${workdir}/trans_cgn_fields_wfo.lsf
  echo " "

# --------------------------------------------------------------------------- #
# 2.  End of all.

  echo ' '
  echo ' '
  echo " Time : `date`"
  echo ' '
  echo '                        *** End of nwps_plot_cgn_dev.cron ***'

# - end of nwps_plot_cgn_dev.cron ----------------------------------------------- #
