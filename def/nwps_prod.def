suite prod
  family primary
    family cron
      family nwps
        edit PROJ 'NWPS'
        edit PACKAGEHOME '/lfs/h1/ops/%ENVIR%/packages/nwps.%nwps_ver%'
        edit KEEPDATA 'NO'
        family v1.5
          limit nwps_jobs 22
          task jnwps_datachk
            edit QUEUE 'prod_transfer'
            edit SENDWEB 'YES'
            edit ECF_PASS 'FREE'
            cron 00:01 23:57 00:01
          task jnwps_datachk_info
            defstatus complete
            label queued " "
          family regions
            edit KEEPDATA 'YES'
            edit NODES '2'
            inlimit nwps_jobs
